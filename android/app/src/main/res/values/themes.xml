<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SleeprAid" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- The background color must be a solid color on API 31+ -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Using a custom drawable to clean up edge artifacts and center the logo -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- Matching the icon's background to the splash background to hide edge artifacts -->
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.SleeprAid</item>
    </style>
</resources>